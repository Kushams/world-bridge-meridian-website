# No environment variables are required to run the site today.
# This file documents variables future integrations will need — copy to
# .env.local and fill in real values only when wiring up that integration.
# Never commit a filled-in .env* file.

# Journey-request form delivery (future)
# CONTACT_FORM_EMAIL_TO=
# EMAIL_PROVIDER_API_KEY=

# CRM integration (future)
# CRM_API_KEY=

# Payment provider (future — cards / bank transfer / crypto)
# PAYMENT_PROVIDER_SECRET_KEY=

# User accounts + saved trips synced across devices (Supabase — free tier)
# 1. Create a free project at https://supabase.com
# 2. Project Settings -> API -> copy "Project URL" and the "anon public" key
# 3. SQL Editor -> paste and run supabase/schema.sql (once)
# 4. Authentication -> URL Configuration -> set Site URL to
#    https://worldbridgemeridian.com so sign-in links point at the live site
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Live chat routed to our own team (Tawk.to — free)
# 1. Create a free account at https://www.tawk.to
# 2. Admin -> your property -> Channels -> Chat Widget
# 3. Copy the two IDs out of the widget script URL:
#    embed.tawk.to/<PROPERTY_ID>/<WIDGET_ID>
# NEXT_PUBLIC_TAWK_PROPERTY_ID=
# NEXT_PUBLIC_TAWK_WIDGET_ID=

# Visitor analytics (Google Analytics 4 — free)
# 1. Create a free account/property at https://analytics.google.com
# 2. Admin -> Data Streams -> Web -> your stream -> copy the Measurement ID
#    (starts with "G-")
# NEXT_PUBLIC_GA_MEASUREMENT_ID=
