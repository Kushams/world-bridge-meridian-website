# Lead-generation module ignore rules.
#
# master_leads.csv / opportunities.csv are the committed sources of truth.
# EVERYTHING below is derived or transient and must never be committed.

# Derived per-pipeline segment files (regenerate with `npm run leads:segment`)
data/*/*.csv
data/*/*/*.csv
!data/master/*.csv
!data/seasonal/*.csv

# Staged batches and rejected records (may contain personal data)
data/incoming/*
!data/incoming/.gitkeep

# Exports for the outreach team (derived; contain personal data)
exports/*
!exports/.gitkeep

# Secrets / local environment - never commit
.env
.env.*
!.env.example
*.key
*.pem
*.secret
*credentials*
*.tmp-*
